<?xml version="1.0" encoding="UTF-8"?>
<!--
  生产级日志配置：
  - 每行带 traceId/userId/tenantId（MDC），消息统一走 %maskedMsg 脱敏
  - dev/default：可读文本；prod：JSON（logstash encoder，便于采集）
  - 应用日志 / 错误日志 / 访问日志分文件，异步写盘避免阻塞业务线程
  - 访问日志由 ACCESS_LOG logger 输出（见 AccessLogFilter）
-->
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="atry"/>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="LOG_ENV" value="${LOG_ENV:-default}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-} userId=%X{userId:-} tenantId=%X{tenantId:-}] %logger{40} - %maskedMsg%n"/>
    <property name="ACCESS_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %maskedMsg%n"/>
    <property name="ROLLING_PATTERN"
              value="${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz"/>

    <conversionRule conversionWord="maskedMsg"
                    converterClass="com.wherelee.base.modules.platform.logging.MaskingConverter"/>

    <!-- ===================== 文本输出（dev/default） ===================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ROLLING_PATTERN}</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-access.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${ACCESS_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
    </appender>
    <appender name="ASYNC_APP_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="APP_FILE"/>
    </appender>
    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>
    <appender name="ASYNC_ACCESS_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ACCESS_FILE"/>
    </appender>

    <!-- ===================== JSON 输出（prod，供日志平台采集） ===================== -->
    <springProfile name="prod">
        <appender name="APP_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}.json.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}.json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}","env":"${LOG_ENV}"}</customFields>
                <includeMdc>true</includeMdc>
                <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                    <value>(?i)\bBearer\s+[A-Za-z0-9._~+/=-]+</value>
                    <value>(?i)\b(?:password|passwd|pwd|token|access_token|refresh_token|authorization|secret|api[_-]?key|credential)\b\s*[=:]\s*[^&amp;,\s"'}]+</value>
                    <value>\b1[3-9]\d{9}\b</value>
                    <value>\b\d{17}[\dXx]\b</value>
                    <value>[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}</value>
                </jsonGeneratorDecorator>
            </encoder>
        </appender>

        <appender name="ERROR_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}-error.json.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}-error.json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}","env":"${LOG_ENV}"}</customFields>
                <includeMdc>true</includeMdc>
                <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                    <value>(?i)\bBearer\s+[A-Za-z0-9._~+/=-]+</value>
                    <value>(?i)\b(?:password|passwd|pwd|token|access_token|refresh_token|authorization|secret|api[_-]?key|credential)\b\s*[=:]\s*[^&amp;,\s"'}]+</value>
                    <value>\b1[3-9]\d{9}\b</value>
                    <value>\b\d{17}[\dXx]\b</value>
                    <value>[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}</value>
                </jsonGeneratorDecorator>
            </encoder>
        </appender>

        <appender name="ACCESS_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}-access.json.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}-access.json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}","env":"${LOG_ENV}"}</customFields>
                <includeMdc>true</includeMdc>
            </encoder>
        </appender>

        <appender name="ASYNC_APP_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>4096</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="APP_JSON"/>
        </appender>
        <appender name="ASYNC_ERROR_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="ERROR_JSON"/>
        </appender>
        <appender name="ASYNC_ACCESS_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>4096</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="ACCESS_JSON"/>
        </appender>

        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_APP_JSON"/>
            <appender-ref ref="ASYNC_ERROR_JSON"/>
        </root>

        <logger name="ACCESS_LOG" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_ACCESS_JSON"/>
        </logger>
    </springProfile>

    <springProfile name="!prod">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_APP_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>

        <logger name="ACCESS_LOG" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_ACCESS_FILE"/>
        </logger>
    </springProfile>

    <logger name="com.wherelee.base" level="${LOG_LEVEL_BASE:-INFO}"/>
    <logger name="org.flywaydb" level="INFO"/>
</configuration>
