# 用法（二选一）：
#   1) cp .env.docker.example .env.docker && docker compose --env-file .env.docker up -d
#      （compose 变量插值只读 .env，不读 .env.docker，必须显式 --env-file）
#   2) cp .env.docker.example .env        && docker compose up -d   # compose 默认读取 .env
#
# 注意：修改 DB_PASSWORD / REDIS_PASSWORD 后，已存在的 mysql 数据卷不会重建账号
#       （mysql:8.0 仅在数据目录为空时初始化；backend 会连不上而无限重启）。需要重建时：
#         docker compose down -v   或   使用不同 -p <project-name>
#
# Host ports. Cloud staging should override these to avoid the systemd 8084/9091.
# Backend and Actuator bind to loopback so only nginx is publicly reachable.
BACKEND_BIND=127.0.0.1
MANAGEMENT_BIND=127.0.0.1
MYSQL_BIND=127.0.0.1
MYSQL_HOST_PORT=13306
REDIS_BIND=127.0.0.1
REDIS_HOST_PORT=16379
BACKEND_PORT=8084
MANAGEMENT_PORT=9091

DB_USER=atry
DB_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me-redis
REDIS_DATABASE=0
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUST_FORWARDED_HEADERS=true
APP_BASE_URL=http://127.0.0.1:8080
PAYMENT_PROVIDER=mock
PAYMENT_APP_ID=atry
PAYMENT_MOCK_ENABLED=true
# 无公网域名时保持 true：内核定时查单轮询结算；有域名后可保留为兜底
PAYMENT_QUERY_ENABLED=true
PAYMENT_QUERY_INTERVAL_MS=30000

# 真实支付宝（PAYMENT_PROVIDER=alipay 时填写；无域名可不填 NOTIFY/RETURN）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
# T+1 账单对账（需要商户账单权限）
ALIPAY_BILL_ENABLED=false
ALIPAY_BILL_TYPE=trade
ALIPAY_BILL_CHARSET=GBK
SEED_ADMIN_PASSWORD=
ALERT_WEBHOOK_URL=
TRACING_ENABLED=false
OTLP_TRACING_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Optional observability profile
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=14318

# Optional container tuning. Values are deliberately small enough for the
# 3.7GB cloud host to run staging beside the systemd production process.
# backend 堆 = BACKEND_MEM_LIMIT × 50%（768m → 384MiB 堆），非堆约 221m + 映射约 70m
MYSQL_BUFFER_POOL_SIZE=128M
MYSQL_MEM_LIMIT=768m
REDIS_MEM_LIMIT=192m
BACKEND_MEM_LIMIT=768m
